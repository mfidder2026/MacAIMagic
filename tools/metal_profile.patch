+// GGML_METAL_PROFILE: GPU time per kind of op (op type, weight type, fused) and per part of a layer (tensor name
+// without its layer number); the table is printed when the program ends
+#define GGML_METAL_PROFILE_MAX 512
+static struct { char key[96]; double t; long n; } g_prof[GGML_METAL_PROFILE_MAX];
+static int    g_prof_n = 0;
+static double g_prof_total = 0.0;
+static long   g_prof_groups = 0;
+static long   g_prof_graphs = 0;
+
+static void ggml_metal_profile_put(const char * key, double t) {
+    for (int i = 0; i < g_prof_n; ++i) {
+        if (strcmp(g_prof[i].key, key) == 0) { g_prof[i].t += t; g_prof[i].n += 1; return; }
+    }
+    if (g_prof_n < GGML_METAL_PROFILE_MAX) {
+        snprintf(g_prof[g_prof_n].key, sizeof(g_prof[0].key), "%s", key);
+        g_prof[g_prof_n].t = t; g_prof[g_prof_n].n = 1; g_prof_n += 1;
+    }
+}
+
+static int ggml_metal_profile_cmp(const void * a, const void * b) {
+    const double ta = ((const typeof(g_prof[0]) *) a)->t, tb = ((const typeof(g_prof[0]) *) b)->t;
+    return ta < tb ? 1 : ta > tb ? -1 : 0;
+}
+
+static void ggml_metal_profile_print(void) {
+    if (g_prof_graphs == 0) return;
+    qsort(g_prof, g_prof_n, sizeof(g_prof[0]), ggml_metal_profile_cmp);
+    fprintf(stderr, "\nGGML_METAL_PROFILE: %ld graphs, %.3f ms GPU per graph, %.1f op groups per graph\n",
+            g_prof_graphs, 1e3 * g_prof_total / g_prof_graphs, (double) g_prof_groups / g_prof_graphs);
+    for (int i = 0; i < g_prof_n; ++i) {
+        fprintf(stderr, "PROF %-60s %9.3f ms/graph %6.1f%% %7.1f x/graph %8.1f us/x\n", g_prof[i].key,
+                1e3 * g_prof[i].t / g_prof_graphs, 100.0 * g_prof[i].t / (g_prof_total > 0 ? g_prof_total : 1),
+                (double) g_prof[i].n / g_prof_graphs, 1e6 * g_prof[i].t / g_prof[i].n);
+    }
+}
+
+static void ggml_metal_profile_add(const struct ggml_tensor * node, int n_fused, double t) {
+    static bool registered = false;
+    if (!registered) { atexit(ggml_metal_profile_print); registered = true; }
+    char key[96];
+    const char * w = "";
+    if ((node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) && node->src[0]) {
+        w = ggml_type_name(node->src[0]->type);
+    }
+    snprintf(key, sizeof(key), "op   %s %s%s", ggml_op_desc(node), w, n_fused > 1 ? " (fused)" : "");
+    ggml_metal_profile_put(key, t);
+    // the tensor name without its layer number: ffn_moe_down-12 -> ffn_moe_down
+    char name[64];
+    snprintf(name, sizeof(name), "%s", ggml_get_name(node));
+    char * dash = strrchr(name, '-');
+    if (dash && dash[1] >= '0' && dash[1] <= '9') { *dash = 0; }
+    if (strncmp(name, "node_", 5) == 0) { snprintf(name, sizeof(name), "node_*"); }
+    snprintf(key, sizeof(key), "name %s [%s %s]", name[0] ? name : "(no name)", ggml_op_desc(node), w);
+    ggml_metal_profile_put(key, t);
+}
+
+static void ggml_metal_profile_graph(double total, int groups) {
+    g_prof_total += total;
+    g_prof_groups += groups;
+    g_prof_graphs += 1;
+}
