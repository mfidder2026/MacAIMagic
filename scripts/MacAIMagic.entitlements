<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- the app asks for the administrator password with AppleScript to raise the GPU memory limit -->
  <key>com.apple.security.automation.apple-events</key><true/>
  <!-- the built-in connector Agenda en Herinneringen (EventKit); the hardened runtime needs it for calendars and reminders -->
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict>
</plist>
